@model FoodOrderingSystem.Models.ViewModels.ShoppingCartVM

<form method="post">
    <br />
    <div class="card shadow border-0">
        <div class="card-header bg-primary bg-gradient text-light ml-0 py-4">
            <div class="row px-4">
                <div class="col-6">
                    <h3 class="pt-2 text-white">Shopping Cart</h3>
                </div>
                <div class="col-6 text-end">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm text-uppercase">Continue Shopping</a>
                </div>
            </div>
        </div>
        <div class="card-body my-4">
            <div class="row mb-3 pb-3">
                <div class="col-md-10 offset-md-1">

                    @foreach (var item in Model.ListCart)
                    {
                        <div class="row border-bottom pb-3 mb-3">
                            <div class="col-12 col-lg-2 text-center py-2">
                                <img src="@item.FoodItem.ImageUrl" class="rounded w-100 shadow-sm" />
                            </div>
                            <div class="col-12 col-lg-5 pt-md-3">
                                <h5 class="text-uppercase text-secondary"><strong>@item.FoodItem.Name</strong></h5>
                                <p><small>@Html.Raw(item.FoodItem.Description)</small></p>
                            </div>
                            <div class="col-12 col-lg-5 text-center row">
                                <div class="col-4 text-md-right pt-2 pt-md-4">
                                    <h6 class="fw-semibold">
                                        $@item.FoodItem.Price.ToString("0.00")
                                        <span class="text-muted">&nbsp;x&nbsp;</span>@item.Count
                                    </h6>
                                </div>
                                <div class="col-6 col-sm-4 col-lg-6 pt-2">
                                    <div class="w-75 btn-group" role="group">
                                        <a asp-action="Plus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2">
                                            +
                                        </a> &nbsp;
                                        <a asp-action="Minus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2">
                                            -
                                        </a>
                                    </div>
                                </div>
                                <div class="col-2 col-sm-4 col-lg-2 text-right pt-2">
                                    <a asp-action="Remove" asp-route-cartId="@item.Id" class="btn btn-danger py-2">
                                        Trash
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row border-top pt-3">
                        <div class="col-md-6 offset-md-6 text-end">
                            <ul class="list-group mb-4">
                                <li class="list-group-item d-flex justify-content-between bg-light">
                                    <h5 class="text-info"> Total (USD)</h5>
                                    <h5 class="text-info fw-bold">$@Model.OrderTotal.ToString("0.00")</h5>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
        <div class="card-footer bg-white border-0">
            <div class="row">
                <div class="col-md-4 offset-md-8">
                    <!-- We will build the Summary/Checkout page next -->
                    <a asp-action="Summary" class="btn btn-success border-0 bg-gradient w-100 py-2 text-uppercase">Summary</a>
                </div>
            </div>
        </div>
    </div>
</form>