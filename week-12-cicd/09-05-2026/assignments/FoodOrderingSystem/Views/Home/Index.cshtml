@model IEnumerable<FoodOrderingSystem.Models.FoodItem>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container pb-3 mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Welcome to Our Restaurant</h1>
        <p class="lead text-muted">Browse our delicious menu and order your favorites.</p>
    </div>

    <div class="row pb-3">
        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <!-- Food Image -->
                    <img src="@item.ImageUrl" class="card-img-top rounded-top-3" alt="@item.Name" style="height: 200px; object-fit: cover;">
                    
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <!-- Food Name -->
                            <h5 class="card-title text-dark fw-bold mb-0">@item.Name</h5>
                            <!-- Category Badge -->
                            <span class="badge bg-info text-dark align-self-start">@item.Category.Name</span>
                        </div>
                        
                        <!-- Description -->
                        <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                            @Html.Raw(item.Description)
                        </p>
                        
                        <!-- Price and Action Button -->
                        <div class="mt-auto">
                            <h4 class="text-success fw-bold mb-3">$@item.Price.ToString("0.00")</h4>
                            
                            <!-- This button will eventually take them to a details page to pick quantity -->
                            <a asp-action="Details" asp-route-productId="@item.Id" class="btn btn-primary w-100 shadow-sm">
                                Details / Add to Cart
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>